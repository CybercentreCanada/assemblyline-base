error_log    ${ERROR_LOG} ${ERROR_LEVEL};

server {
    server_name               ${FQDN};
    listen                    443 ssl;
    charset                   utf-8;
    client_max_body_size      ${MAX_BODY_SIZE};

    ssl_session_cache         shared:SSL:20m;
    ssl_session_timeout       60m;
    ssl_prefer_server_ciphers on;
    ssl_ciphers               ECDH+AESGCM:ECDH+AES256:ECDH+AES128:DHE+AES128:!ADH:!AECDH:!MD5;
    ssl_protocols             TLSv1 TLSv1.1 TLSv1.2;

    ssl_certificate           /etc/ssl/nginx.crt;
    ssl_certificate_key       /etc/ssl/nginx.key;

    server_tokens off;

    access_log    ${ACCESS_LOG};

    # this is the internal Docker DNS, cache only for 30s
    resolver 127.0.0.11 valid=30s;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_http_version 1.1;
    gzip_disable "^(?!.*(Mozilla|AppleWebKit|Chrome|Safari|Windows|Macintosh|Linux))";
    gzip_types
        application/javascript
        application/json
        application/xml
        image/svg+xml
        text/css
        text/javascript
        text/plain
        text/xml;

    proxy_read_timeout ${READ_TIMEOUT};
    proxy_connect_timeout ${CONNECT_TIMEOUT};
    proxy_send_timeout ${SEND_TIMEOUT};

    location / {
        try_files    $uri @frontend;
    }

    # UI
    location @frontend {
        add_header            X-Frame-Options            SAMEORIGIN;
        add_header            Strict-Transport-Security  "max-age=31536000; includeSubDomains";

        proxy_set_header      X-Forwarded-For            $proxy_add_x_forwarded_for;
        proxy_set_header      X-Remote-Cert-Verified     $ssl_client_verify;
        proxy_set_header      X-Remote-DN                $ssl_client_s_dn;
        proxy_set_header      Host                       $http_host;
        proxy_set_header      Scheme                     $scheme;
        proxy_set_header      Server-Port                $server_port;

        set $frontend "http://${FRONTEND_HOST}:3000";

        proxy_pass            $frontend;
    }

    # Used for WebSocket connections to the frontend in development
    location /ws {
        add_header            Strict-Transport-Security    "max-age=31536000; includeSubDomains";

        proxy_set_header      X-Remote-User   $remote_user;
        proxy_set_header      X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header      Host            $http_host;
        proxy_redirect        off;
        proxy_buffering       off;
        proxy_http_version    1.1;
        proxy_set_header      Upgrade         $http_upgrade;
        proxy_set_header      Connection      "upgrade";

        set $frontend_ws "http://${FRONTEND_HOST}:3000/ws";

        proxy_pass            $frontend_ws;
    }

    # Route for accessing Kibana if deployed
    location /kibana/ {
        proxy_http_version 1.1;
        proxy_set_header      Upgrade     $http_upgrade;
        proxy_set_header      Connection  'upgrade';
        proxy_set_header      Host        $host;
        proxy_cache_bypass    $http_upgrade;

        set $kibana "http://${KIBANA_HOST}:5601";
        proxy_pass            $kibana;
    }

    # SocketIO
    location /socket.io/ {
        add_header            Strict-Transport-Security    "max-age=31536000; includeSubDomains";

        proxy_set_header      X-Remote-User   $remote_user;
        proxy_set_header      X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header      Host            $http_host;
        proxy_redirect        off;
        proxy_buffering       off;
        proxy_http_version    1.1;
        proxy_set_header      Upgrade         $http_upgrade;
        proxy_set_header      Connection      "upgrade";

        set $socketio "http://${SOCKET_HOST}:5002";

        proxy_pass            $socketio;
    }

    # REST API
    location /api/ {
        add_header            X-Frame-Options            SAMEORIGIN;
        add_header            Strict-Transport-Security  "max-age=31536000; includeSubDomains";

        proxy_set_header      X-Forwarded-For            $proxy_add_x_forwarded_for;
        proxy_set_header      X-Remote-Cert-Verified     $ssl_client_verify;
        proxy_set_header      X-Remote-DN                $ssl_client_s_dn;
        proxy_set_header      Host                       $http_host;
        proxy_set_header      Scheme                     $scheme;
        proxy_set_header      Server-Port                $server_port;

        set $api "http://${UI_HOST}:5000";
        proxy_pass            $api;
    }

    # MCP
    location /mcp/ {
        add_header            X-Frame-Options            SAMEORIGIN;
        add_header            Strict-Transport-Security  "max-age=31536000; includeSubDomains";

        proxy_set_header      X-Forwarded-For            $proxy_add_x_forwarded_for;
        proxy_set_header      X-Remote-Cert-Verified     $ssl_client_verify;
        proxy_set_header      X-Remote-DN                $ssl_client_s_dn;
        proxy_set_header      Host                       $http_host;
        proxy_set_header      Scheme                     $scheme;
        proxy_set_header      Server-Port                $server_port;

        set $mcp "http://${MCP_HOST}:8000";
        proxy_pass            $mcp;
    }
}
